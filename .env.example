# MedPlab-Agent Environment Configuration
# Copy this file to .env and set your API keys if available.
# The system also works in offline heuristic mode without API keys.

# Google Gemini API Key (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
